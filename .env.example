# ==============================================================================
# LUMI AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
PROJECT_NAME="Lumi AI"
VERSION=1.0.0

# Security & Authentication (Change in production!)
SECRET_KEY=lumi-ai-production-super-secret-key-change-in-production-2025
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite by default, PostgreSQL supported)
DATABASE_URL=sqlite:///./data/lumi.db
# For PostgreSQL:
# DATABASE_URL=postgresql://lumi_user:lumi_password@localhost:5432/lumi_db

# Groq Generative AI Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
LLM_REQUEST_TIMEOUT=60.0
MAX_CONVERSATION_CONTEXT=20

# Document Ingestion & RAG Configuration
EMBEDDING_PROVIDER=local
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Web Search Configuration (DuckDuckGo works out of the box without API keys)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# Optional: Tavily Search (if WEB_SEARCH_PROVIDER=tavily)
# TAVILY_API_KEY=

# Optional: SerpAPI Search (if WEB_SEARCH_PROVIDER=serpapi)
# SERPAPI_API_KEY=
